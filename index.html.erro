<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SubliBox QR | Gerador de QR Code WhatsApp e Placa de Balcão 10×15cm PRO</title>
  <meta name="description" content="Gere grátis seu QR Code do WhatsApp e sua Placa Simples 10×15cm, ou crie a Placa Profissional 4 em 1 PRO (10×15cm) com WhatsApp, Pix, Wi-Fi e Instagram em 600 DPI pronta para imprimir." />
  <meta name="robots" content="index, follow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            display: ['"Oswald"', 'sans-serif']
          },
          colors: {
            brand: {
              50: '#f0f7ff',
              100: '#e0effe',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
              900: '#0c4a6e'
            }
          }
        }
      }
    };
  </script>
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #f8fafc;
      color: #0f172a;
    }
    .font-display {
      font-family: 'Oswald', sans-serif;
    }
    .preview-grid-bg {
      background-color: #e2e8f0;
      background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
      background-size: 16px 16px;
    }
    input[type="color"] {
      -webkit-appearance: none;
      border: none;
      width: 36px;
      height: 36px;
      border-radius: 8px;
      cursor: pointer;
      padding: 0;
      overflow: hidden;
    }
    input[type="color"]::-webkit-color-swatch-wrapper {
      padding: 0;
    }
    input[type="color"]::-webkit-color-swatch {
      border: 1px solid #cbd5e1;
      border-radius: 8px;
    }
  </style>
</head>
<body class="antialiased selection:bg-sky-500 selection:text-white">

  <!-- Toast de Notificação -->
  <div id="toast" class="fixed bottom-5 right-5 z-50 hidden max-w-sm rounded-xl bg-slate-900 px-4 py-3 text-sm font-medium text-white shadow-2xl border border-slate-700 transition-all"></div>

  <!-- Header -->
  <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
      <a href="#" class="flex items-center gap-2.5">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-sky-600 to-blue-800 text-white font-display font-bold text-lg shadow-sm">
          QR
        </div>
        <div>
          <span class="font-extrabold tracking-tight text-slate-900 text-lg">SubliBox</span>
          <span class="ml-1 rounded-md bg-sky-100 px-1.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-sky-800">QR</span>
        </div>
      </a>
      <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-600">
        <a href="#gerador-gratis" class="hover:text-sky-600 transition">QR WhatsApp Grátis</a>
        <a href="#placa-simples" class="hover:text-sky-600 transition">Placa Simples 10×15</a>
        <a href="#placa-pro" class="inline-flex items-center gap-1.5 rounded-full bg-amber-100/80 px-3 py-1 text-amber-900 hover:bg-amber-200/80 transition">
          <span>Placa 4 em 1 PRO</span>
          <span class="rounded bg-amber-500 px-1.5 py-0.2 text-[10px] font-extrabold text-white">10×15cm</span>
        </a>
        <a href="#suporte-acrilico" class="hover:text-sky-600 transition">Suporte de Acrílico</a>
      </nav>
      <a href="#placa-pro" class="rounded-xl bg-slate-900 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-slate-800 transition sm:text-sm">
        Criar Placa PRO
      </a>
    </div>
  </header>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-slate-200 bg-white pt-10 pb-14 sm:pt-14 sm:pb-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-sky-200 bg-sky-50 px-3.5 py-1 text-xs font-bold text-sky-800">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          100% Privado • Dados processados localmente no seu navegador
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl sm:leading-tight">
          QR Code para WhatsApp e <span class="text-sky-600">Placa de Balcão 10×15cm</span> Pronta para Imprimir
        </h1>
        <p class="mt-4 text-base text-slate-600 sm:text-lg">
          Gere gratuitamente seu QR Code do WhatsApp ou monte sua <strong>Placa 4 em 1 PRO (10×15cm)</strong> reunindo WhatsApp, Pix, Wi-Fi e Instagram em alta resolução (600 DPI).
        </p>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
          <a href="#placa-pro" class="rounded-xl bg-sky-600 px-6 py-3.5 text-sm font-bold text-white shadow-md shadow-sky-600/20 hover:bg-sky-700 transition">
            Montar Placa 4 em 1 PRO (10×15cm)
          </a>
          <a href="#gerador-gratis" class="rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-sm font-bold text-slate-700 hover:bg-slate-50 transition">
            Usar Gerador Gratuito
          </a>
        </div>
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-6xl space-y-16 px-4 py-12 sm:px-6">

    <!-- SEÇÃO 1: GERADOR GRATUITO WHATSAPP + PLACA SIMPLES 10x15 -->
    <section id="gerador-gratis" class="scroll-mt-24">
      <div class="mb-6">
        <span class="text-xs font-extrabold uppercase tracking-wider text-sky-600">Ferramenta Gratuita</span>
        <h2 class="text-2xl font-extrabold text-slate-900 sm:text-3xl">1. Gerador de QR Code WhatsApp & Placa Simples 10×15cm</h2>
        <p class="mt-1 text-sm text-slate-600">Digite seu WhatsApp com DDD e baixe gratuitamente o QR Code isolado ou a placa simples 10×15cm.</p>
      </div>

      <div class="grid gap-8 lg:grid-cols-12">
        <!-- Formulário WhatsApp -->
        <div class="space-y-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-5">
          <div>
            <label for="wa-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700">WhatsApp com DDD *</label>
            <input
              id="wa-phone"
              type="tel"
              placeholder="(85) 99999-9999"
              class="mt-1.5 w-full rounded-xl border border-slate-300 px-4 py-3 text-base font-semibold text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20"
            />
          </div>

          <div>
            <label for="wa-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Mensagem inicial automática (opcional)</label>
            <textarea
              id="wa-message"
              rows="3"
              placeholder="Olá! Vim pelo QR Code do balcão e gostaria de atendimento."
              class="mt-1.5 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20"
            ></textarea>
          </div>

          <div class="rounded-xl bg-slate-50 p-3.5 border border-slate-200/80">
            <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-500">Link direto gerado</span>
            <div class="mt-1 flex items-center justify-between gap-2">
              <code id="wa-link-preview" class="truncate text-xs font-semibold text-sky-700">https://wa.me/55...</code>
              <button type="button" id="copy-wa-link" class="shrink-0 rounded-lg bg-white border border-slate-300 px-2.5 py-1 text-xs font-bold text-slate-700 hover:bg-slate-100">
                Copiar
              </button>
            </div>
          </div>

          <div class="pt-1 space-y-2.5">
            <button type="button" id="download-free-qr" class="w-full rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white shadow-sm hover:bg-emerald-700 transition">
              Baixar QR Code WhatsApp Grátis (PNG)
            </button>
            <button type="button" id="download-simple-board" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800 hover:bg-slate-50 transition">
              Baixar Placa Simples 10×15cm Grátis (PNG)
            </button>
          </div>
        </div>

        <!-- Prévia QR Grátis e Placa Simples -->
        <div id="placa-simples" class="grid gap-6 sm:grid-cols-2 lg:col-span-7">
          <!-- Card QR Isolado -->
          <div class="flex flex-col items-center justify-between rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
            <div class="w-full">
              <span class="inline-block rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">Grátis • Alta Nitidez</span>
              <h3 class="mt-2 text-base font-extrabold text-slate-900">QR Code Isolado</h3>
              <p class="text-xs text-slate-500">Ideal para colar em artes, cartões ou adesivos</p>
            </div>
            <div class="my-5 flex h-52 w-52 items-center justify-center rounded-2xl border border-slate-200 bg-white p-3 shadow-inner">
              <canvas id="free-qr-canvas" width="400" height="400" class="h-full w-full object-contain"></canvas>
            </div>
            <span class="text-[11px] font-medium text-slate-400">Sem marca d'água • Uso livre</span>
          </div>

          <!-- Card Placa Simples 10x15 -->
          <div class="flex flex-col items-center justify-between rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
            <div class="w-full">
              <span class="inline-block rounded-full bg-sky-50 px-2.5 py-0.5 text-[11px] font-bold text-sky-700">Grátis • 10 × 15 cm</span>
              <h3 class="mt-2 text-base font-extrabold text-slate-900">Placa Simples WhatsApp</h3>
              <p class="text-xs text-slate-500">Formato vertical 10×15cm pronto para imprimir</p>
            </div>
            <div class="my-4 flex items-center justify-center rounded-xl border border-slate-200 preview-grid-bg p-3">
              <canvas id="simple-board-canvas" width="1181" height="1772" class="h-48 w-auto rounded-lg shadow-md bg-white"></canvas>
            </div>
            <span class="text-[11px] font-medium text-slate-400">300 DPI • 100 × 150 mm</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SEÇÃO 2: PLACA DE BALCÃO 4 EM 1 PRO (10x15cm) -->
    <section id="placa-pro" class="scroll-mt-24 rounded-3xl border-2 border-sky-600/20 bg-white p-6 shadow-xl sm:p-10">
      <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-200 pb-6">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-amber-100 px-3 py-1 text-xs font-extrabold uppercase tracking-wider text-amber-900">
            Edição Profissional • 600 DPI
          </div>
          <h2 class="mt-2 text-2xl font-extrabold text-slate-900 sm:text-3xl">
            2. Placa de Balcão 4 em 1 PRO (10×15cm)
          </h2>
          <p class="mt-1 max-w-2xl text-sm text-slate-600">
            Reúna <strong>WhatsApp, Pix, Wi-Fi e Instagram</strong> em uma única placa vertical <strong>10 × 15 cm</strong> com a identidade visual da sua loja. Baixe em <strong>PNG (600 DPI)</strong> e <strong>PDF A4 (1 página centralizada em 100×150mm)</strong>.
          </p>
        </div>

        <div class="rounded-2xl border border-sky-200 bg-sky-50 px-5 py-3 text-right">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-sky-800">Pagamento Único</span>
          <span id="pro-price-display" class="font-display text-3xl font-bold text-slate-900">R$ 9,90</span>
          <span class="block text-[11px] font-medium text-slate-500">Sem mensalidade</span>
        </div>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-12">
        <!-- Controles de Personalização PRO -->
        <div class="space-y-6 lg:col-span-7">

          <!-- Bloco 1: Identidade da Marca -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5">
            <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-800">1. Identidade Visual & Cabeçalho</h3>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <div>
                <label class="block text-xs font-bold text-slate-700">Nome da Empresa / Loja</label>
                <input id="pro-company" type="text" placeholder="Ex: Studio Bella Hair" class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-sky-500 focus:outline-none" />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700">Logomarca (opcional)</label>
                <input id="pro-logo-input" type="file" accept="image/*" class="mt-1 block w-full text-xs text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-sky-600 file:px-3 file:py-2 file:text-xs file:font-bold file:text-white hover:file:bg-sky-700" />
              </div>
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-6">
              <label class="inline-flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                <input id="pro-show-company" type="checkbox" checked class="h-4 w-4 rounded border-slate-300 text-sky-600" />
                Mostrar nome da loja
              </label>
              <label class="inline-flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                <input id="pro-show-logo" type="checkbox" checked class="h-4 w-4 rounded border-slate-300 text-sky-600" />
                Mostrar logo no topo
              </label>
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-5 border-t border-slate-200 pt-4">
              <div class="flex items-center gap-2">
                <input id="pro-primary-color" type="color" value="#14456b" />
                <div>
                  <span class="block text-xs font-bold text-slate-700">Cor Principal</span>
                  <span class="text-[11px] text-slate-500">Topo e molduras</span>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <input id="pro-secondary-color" type="color" value="#5eb5c9" />
                <div>
                  <span class="block text-xs font-bold text-slate-700">Cor de Destaque</span>
                  <span class="text-[11px] text-slate-500">Detalhes e rodapé</span>
                </div>
              </div>
              <button type="button" id="extract-logo-colors" class="hidden rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-100">
                Extrair cores da logo
              </button>
            </div>
          </div>

          <!-- Bloco 2: QR Codes Pix e Wi-Fi -->
          <div class="grid gap-5 sm:grid-cols-2">
            <!-- Pix -->
            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5 space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-extrabold text-teal-800">2. QR Code Pix</h3>
                <span class="rounded bg-teal-100 px-2 py-0.5 text-[10px] font-bold text-teal-800">Print do Banco</span>
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700">Imagem / Print do QR Pix</label>
                <input id="pro-pix-input" type="file" accept="image/*" class="mt-1 block w-full text-xs text-slate-600 file:mr-2.5 file:rounded-lg file:border-0 file:bg-teal-600 file:px-3 py-1.5 file:text-xs file:font-bold file:text-white hover:file:bg-teal-700" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700">Nome do Recebedor (opcional)</label>
                <input id="pro-pix-holder" type="text" placeholder="Ex: Maria Silva Ltda" class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-900" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700">Chave Pix escrita (opcional)</label>
                <input id="pro-pix-key" type="text" placeholder="Ex: 85999999999" class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-900" />
              </div>
            </div>

            <!-- Wi-Fi -->
            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5 space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-extrabold text-sky-800">3. QR Code Wi-Fi</h3>
                <span class="rounded bg-sky-100 px-2 py-0.5 text-[10px] font-bold text-sky-800">Print do Celular</span>
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700">Imagem / Print do QR Wi-Fi</label>
                <input id="pro-wifi-input" type="file" accept="image/*" class="mt-1 block w-full text-xs text-slate-600 file:mr-2.5 file:rounded-lg file:border-0 file:bg-sky-600 file:px-3 py-1.5 file:text-xs file:font-bold file:text-white hover:file:bg-sky-700" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700">Nome da Rede (SSID)</label>
                <input id="pro-wifi-name" type="text" placeholder="Ex: Clientes_VIP" class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-900" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700">Senha do Wi-Fi</label>
                <input id="pro-wifi-pass" type="text" placeholder="Ex: bemvindo2026" class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-900" />
              </div>
            </div>
          </div>

          <!-- Bloco 3: Instagram e Rótulo WhatsApp -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5">
            <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-800">4. Instagram & WhatsApp na Placa</h3>
            <p class="mt-0.5 text-xs text-slate-500">O QR Code do WhatsApp é puxado automaticamente do número preenchido no Passo 1 acima.</p>
            <div class="mt-3 grid gap-4 sm:grid-cols-2">
              <div>
                <label class="block text-xs font-bold text-slate-700">@ do Instagram</label>
                <input id="pro-insta" type="text" placeholder="@sualoja" class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700">Texto abaixo do WhatsApp</label>
                <input id="pro-zap-label" type="text" placeholder="(85) 99999-9999" class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900" />
              </div>
            </div>
          </div>

          <!-- Painel de Checkout / Desbloqueio -->
          <div id="pro-locked-panel" class="rounded-2xl border-2 border-amber-400/70 bg-amber-50/60 p-5">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h4 class="text-base font-extrabold text-slate-900">Liberar Arte Final 10×15cm em Alta Resolução</h4>
                <p class="text-xs text-slate-600">Remove a marca d'água e libera o download imediato em PNG (600 DPI) e PDF A4.</p>
              </div>
              <button type="button" id="pro-pay-btn" class="shrink-0 rounded-xl bg-sky-600 px-6 py-3.5 text-sm font-extrabold text-white shadow-md hover:bg-sky-700 transition">
                Pagar R$ 9,90 e Baixar
              </button>
            </div>

            <details class="mt-4 border-t border-amber-200/80 pt-3">
              <summary class="cursor-pointer text-xs font-bold text-slate-700 hover:text-sky-700">
                Já pagou e voltou do Mercado Pago? Clique para validar seu ID de pagamento
              </summary>
              <div class="mt-2.5 flex flex-col gap-2 sm:flex-row">
                <input id="manual-payment-id" type="text" placeholder="Ex: 12345678901" class="flex-1 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900" />
                <button type="button" id="manual-verify-btn" class="rounded-xl bg-slate-900 px-4 py-2 text-xs font-bold text-white hover:bg-slate-800">
                  Validar Pagamento
                </button>
              </div>
            </details>
          </div>

          <!-- Painel Desbloqueado -->
          <div id="pro-unlocked-panel" class="hidden rounded-2xl border-2 border-emerald-500 bg-emerald-50 p-5">
            <div class="flex items-center justify-between">
              <div>
                <span class="inline-block rounded-full bg-emerald-600 px-2.5 py-0.5 text-[10px] font-extrabold uppercase text-white">Pagamento Confirmado</span>
                <h4 class="mt-1 text-base font-extrabold text-emerald-950">Sua Placa 4 em 1 PRO (10×15cm) está liberada!</h4>
                <p class="text-xs text-emerald-800">Baixe os arquivos finais abaixo. Para impressão caseira ou gráfica, use o PDF A4 em 100%.</p>
              </div>
            </div>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <button type="button" id="download-pro-png" class="rounded-xl bg-emerald-600 px-4 py-3 text-sm font-extrabold text-white shadow-sm hover:bg-emerald-700 transition">
                Baixar PNG 10×15cm (600 DPI)
              </button>
              <button type="button" id="download-pro-pdf" class="rounded-xl bg-slate-900 px-4 py-3 text-sm font-extrabold text-white shadow-sm hover:bg-slate-800 transition">
                Baixar PDF A4 Pronto para Imprimir
              </button>
            </div>
          </div>

        </div>

        <!-- Preview ao Vivo da Placa 10x15 PRO -->
        <div class="flex flex-col items-center lg:col-span-5">
          <div class="sticky top-24 w-full rounded-2xl border border-slate-200 preview-grid-bg p-5 text-center">
            <div class="mb-3 flex items-center justify-between text-xs font-bold text-slate-600">
              <span>Prévia ao Vivo (10 × 15 cm)</span>
              <span class="rounded bg-white px-2 py-0.5 text-[11px] font-extrabold text-slate-800 shadow-sm">2362 × 3543 px</span>
            </div>
            <div class="mx-auto flex justify-center">
              <canvas id="pro-board-canvas" width="2362" height="3543" class="max-h-[540px] w-auto rounded-xl bg-white shadow-2xl border border-slate-300"></canvas>
            </div>
            <p class="mt-3 text-[11px] font-medium text-slate-500">
              Grade vertical 2×2 otimizada para display de balcão acrílico 10×15cm.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SEÇÃO 3: SUPORTE DE ACRÍLICO 10x15 (AFILIADO SHOPEE) -->
    <section id="suporte-acrilico" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <span class="inline-block rounded-full bg-orange-100 px-2.5 py-0.5 text-[11px] font-extrabold text-orange-800">Dica de Acabamento</span>
          <h3 class="mt-1.5 text-xl font-extrabold text-slate-900">Precisa do Display de Acrílico 10×15cm para Balcão?</h3>
          <p class="mt-1 max-w-2xl text-sm text-slate-600">
            Imprima sua placa em papel fotográfico ou couchê 180g, recorte na medida exata de 10×15cm e encaixe em um expositor acrílico em L ou T.
          </p>
        </div>
        <a
          href="https://shopee.com.br/search?keyword=display%20acrilico%2010x15%20balcao"
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="shrink-0 rounded-xl bg-orange-600 px-5 py-3 text-center text-sm font-extrabold text-white shadow-sm hover:bg-orange-700 transition"
        >
          Ver Displays 10×15cm na Shopee
        </a>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-200 bg-white py-8 text-center text-xs text-slate-500">
    <div class="mx-auto max-w-6xl px-4">
      <p class="font-semibold text-slate-700">SubliBox QR • Gerador de Placas de Balcão e QR Codes</p>
      <p class="mt-1">Seus dados de Wi-Fi, Pix e imagens são processados exclusivamente no seu navegador.</p>
    </div>
  </footer>

  <!-- Modal de Recorte de Imagem (Pix / Wi-Fi) -->
  <div id="crop-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/75 p-4 backdrop-blur-sm">
    <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl">
      <h3 id="crop-modal-title" class="text-lg font-extrabold text-slate-900">Ajustar Recorte do QR Code</h3>
      <p class="mt-1 text-xs text-slate-500">Arraste e ajuste o zoom para enquadrar apenas o quadrado do QR Code.</p>

      <div class="mt-4 flex justify-center overflow-hidden rounded-xl border border-slate-300 bg-slate-100 p-2">
        <canvas id="crop-preview-canvas" width="320" height="320" class="h-64 w-64 cursor-move rounded-lg bg-white shadow-inner"></canvas>
      </div>

      <div class="mt-4 space-y-3">
        <div>
          <label class="flex justify-between text-xs font-bold text-slate-700">
            <span>Zoom</span>
            <span id="crop-zoom-val">100%</span>
          </label>
          <input id="crop-zoom" type="range" min="0.5" max="3" step="0.05" value="1" class="mt-1 w-full" />
        </div>
      </div>

      <div class="mt-6 flex justify-end gap-2.5">
        <button type="button" id="crop-cancel-btn" class="rounded-xl border border-slate-300 px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50">
          Cancelar
        </button>
        <button type="button" id="crop-confirm-btn" class="rounded-xl bg-sky-600 px-5 py-2 text-xs font-extrabold text-white hover:bg-sky-700">
          Confirmar Recorte
        </button>
      </div>
    </div>
  </div>

  <!-- Container oculto para biblioteca QRCode.js -->
  <div id="hidden-qr-generator" class="hidden"></div>

  <script>
    // =========================================================================
    // ESTADO GLOBAL & UTILITÁRIOS
    // =========================================================================
    const proState = {
      unlocked: false,
      validatedPaymentId: null,
      orderRef: null,
      sessionToken: null,
      downloadGrant: null,
      approvedCustomizationHash: null,
      companyName: "",
      showCompany: true,
      showLogo: true,
      logoImg: null,
      primaryColor: "#14456b",
      secondaryColor: "#5eb5c9",
      wifiImg: null,
      wifiName: "",
      wifiPass: "",
      pixImg: null,
      pixHolder: "",
      pixKey: "",
      instaHandle: "",
      zapLabel: ""
    };

    function cleanDigits(str) {
      return String(str || "").replace(/\D/g, "");
    }

    function formatPhoneBR(digits) {
      const d = cleanDigits(digits).slice(0, 11);
      if (d.length <= 2) return d;
      if (d.length <= 6) return `(${d.slice(0, 2)}) ${d.slice(2)}`;
      if (d.length <= 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;
      return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;
    }

    function showToast(msg) {
      const el = document.getElementById("toast");
      el.textContent = msg;
      el.classList.remove("hidden");
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => {
        el.classList.add("hidden");
      }, 4200);
    }

    function trackFunnelEvent(name, detail = {}) {
      try {
        window.dispatchEvent(new CustomEvent("sublibox_funnel", { detail: { name, ...detail } }));
      } catch (e) {}
    }

    function buildWhatsAppUrl() {
      const raw = cleanDigits(document.getElementById("wa-phone").value);
      const phone = raw.startsWith("55") && raw.length >= 12 ? raw : `55${raw || "85999999999"}`;
      const msg = (document.getElementById("wa-message").value || "").trim();
      return msg ? `https://wa.me/${phone}?text=${encodeURIComponent(msg)}` : `https://wa.me/${phone}`;
    }

    function generateQRCodeCanvas(text, size = 400) {
      return new Promise((resolve) => {
        const container = document.getElementById("hidden-qr-generator");
        container.innerHTML = "";
        new QRCode(container, {
          text,
          width: size,
          height: size,
          colorDark: "#0f172a",
          colorLight: "#ffffff",
          correctLevel: QRCode.CorrectLevel.M
        });
        setTimeout(() => {
          const qrCanvas = container.querySelector("canvas");
          if (qrCanvas) {
            resolve(qrCanvas);
            return;
          }
          const qrImg = container.querySelector("img");
          const fallback = document.createElement("canvas");
          fallback.width = size;
          fallback.height = size;
          const ctx = fallback.getContext("2d");
          ctx.fillStyle = "#ffffff";
          ctx.fillRect(0, 0, size, size);
          if (qrImg) ctx.drawImage(qrImg, 0, 0, size, size);
          resolve(fallback);
        }, 30);
      });
    }

    async function computeBoardCustomizationHash() {
      const canonical = JSON.stringify({
        phone: cleanDigits(document.getElementById("wa-phone")?.value || ""),
        message: (document.getElementById("wa-message")?.value || "").trim(),
        companyName: proState.companyName.trim(),
        showCompany: Boolean(proState.showCompany),
        showLogo: Boolean(proState.showLogo),
        primaryColor: proState.primaryColor,
        secondaryColor: proState.secondaryColor,
        wifiName: proState.wifiName.trim(),
        wifiPass: proState.wifiPass.trim(),
        pixHolder: proState.pixHolder.trim(),
        pixKey: proState.pixKey.trim(),
        instaHandle: proState.instaHandle.trim(),
        zapLabel: proState.zapLabel.trim(),
        logoLen: proState.logoImg?.src ? proState.logoImg.src.length : 0,
        logoHead: proState.logoImg?.src ? proState.logoImg.src.slice(0, 96) : "",
        wifiLen: proState.wifiImg?.src ? proState.wifiImg.src.length : 0,
        wifiHead: proState.wifiImg?.src ? proState.wifiImg.src.slice(0, 96) : "",
        pixLen: proState.pixImg?.src ? proState.pixImg.src.length : 0,
        pixHead: proState.pixImg?.src ? proState.pixImg.src.slice(0, 96) : ""
      });

      const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(canonical));
      return Array.from(new Uint8Array(buf))
        .map((b) => b.toString(16).padStart(2, "0"))
        .join("");
    }

    // =========================================================================
    // RENDERIZAÇÃO DO QR GRÁTIS & PLACA SIMPLES 10x15
    // =========================================================================
    async function updateMainQR() {
      const waUrl = buildWhatsAppUrl();
      document.getElementById("wa-link-preview").textContent = waUrl;

      const qrCanvas = await generateQRCodeCanvas(waUrl, 400);

      // 1. Canvas QR Isolado
      const freeCanvas = document.getElementById("free-qr-canvas");
      const fCtx = freeCanvas.getContext("2d");
      fCtx.fillStyle = "#ffffff";
      fCtx.fillRect(0, 0, 400, 400);
      fCtx.drawImage(qrCanvas, 16, 16, 368, 368);

      // 2. Canvas Placa Simples 10x15 (1181 x 1772 px @ 300 DPI)
      const sCanvas = document.getElementById("simple-board-canvas");
      const sCtx = sCanvas.getContext("2d");
      const W = 1181;
      const H = 1772;

      sCtx.fillStyle = "#ffffff";
      sCtx.fillRect(0, 0, W, H);

      // Cabeçalho verde WhatsApp
      sCtx.fillStyle = "#16a34a";
      sCtx.fillRect(0, 0, W, 340);

      sCtx.fillStyle = "#ffffff";
      sCtx.font = "bold 76px Oswald, sans-serif";
      sCtx.textAlign = "center";
      sCtx.fillText("FALE CONOSCO", W / 2, 165);

      sCtx.font = "600 44px 'Plus Jakarta Sans', sans-serif";
      sCtx.fillText("Aponte a câmera do celular", W / 2, 255);

      // Moldura QR
      const qrSize = 760;
      const qrX = (W - qrSize) / 2;
      const qrY = 460;
      sCtx.strokeStyle = "#16a34a";
      sCtx.lineWidth = 14;
      roundRect(sCtx, qrX - 30, qrY - 30, qrSize + 60, qrSize + 60, 42);
      sCtx.stroke();

      sCtx.drawImage(qrCanvas, qrX, qrY, qrSize, qrSize);

      // Número abaixo
      const phoneFormatted = formatPhoneBR(document.getElementById("wa-phone").value) || "(85) 99999-9999";
      sCtx.fillStyle = "#0f172a";
      sCtx.font = "bold 62px 'Plus Jakarta Sans', sans-serif";
      sCtx.fillText(phoneFormatted, W / 2, 1390);

      sCtx.fillStyle = "#64748b";
      sCtx.font = "600 34px 'Plus Jakarta Sans', sans-serif";
      sCtx.fillText("Atendimento via WhatsApp", W / 2, 1465);

      // Barra inferior
      sCtx.fillStyle = "#16a34a";
      sCtx.fillRect(0, H - 70, W, 70);

      renderProBoard();
    }

    function roundRect(ctx, x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r);
      ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r);
      ctx.arcTo(x, y, x + w, y, r);
      ctx.closePath();
    }

    // =========================================================================
    // RENDERIZAÇÃO DA PLACA 4 EM 1 PRO (10x15cm - 2362 x 3543 px @ 600 DPI)
    // =========================================================================
    async function renderProBoard(targetCanvas = null, forceClean = false) {
      const canvas = targetCanvas || document.getElementById("pro-board-canvas");
      const ctx = canvas.getContext("2d");
      const W = 2362;
      const H = 3543;
      canvas.width = W;
      canvas.height = H;

      const primary = proState.primaryColor || "#14456b";
      const secondary = proState.secondaryColor || "#5eb5c9";
      const isProtected = !forceClean && !proState.unlocked;

      // Fundo branco
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, W, H);

      // Borda externa sutil de corte
      ctx.strokeStyle = "#e2e8f0";
      ctx.lineWidth = 6;
      ctx.strokeRect(3, 3, W - 6, H - 6);

      // Cabeçalho Curvo / Retangular Moderno
      const headerH = 620;
      ctx.fillStyle = primary;
      ctx.fillRect(0, 0, W, headerH);

      ctx.fillStyle = secondary;
      ctx.fillRect(0, headerH - 26, W, 26);

      let cursorY = 115;

      // Logo (se habilitado e carregado)
      if (proState.showLogo && proState.logoImg) {
        const maxLogoW = 540;
        const maxLogoH = 220;
        const ratio = Math.min(maxLogoW / proState.logoImg.width, maxLogoH / proState.logoImg.height);
        const lw = proState.logoImg.width * ratio;
        const lh = proState.logoImg.height * ratio;

        ctx.fillStyle = "#ffffff";
        roundRect(ctx, (W - lw) / 2 - 28, cursorY - 16, lw + 56, lh + 32, 28);
        ctx.fill();

        ctx.drawImage(proState.logoImg, (W - lw) / 2, cursorY, lw, lh);
        cursorY += lh + 65;
      } else {
        cursorY += 55;
      }

      // Nome da Empresa
      const displayCompany = (proState.companyName || "").trim() || "SUA LOJA AQUI";
      if (proState.showCompany) {
        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 104px Oswald, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText(displayCompany.toUpperCase().slice(0, 26), W / 2, cursorY + 60);
        cursorY += 125;
      }

      ctx.fillStyle = "#e0f2fe";
      ctx.font = "600 46px 'Plus Jakarta Sans', sans-serif";
      ctx.textAlign = "center";
      ctx.fillText("APONTE A CÂMERA DO CELULAR PARA INTERAGIR", W / 2, headerH - 65);

      // Gerar QRs dinâmicos (WhatsApp e Instagram)
      const waUrl = buildWhatsAppUrl();
      const waQrCanvas = await generateQRCodeCanvas(waUrl, 600);

      const rawInsta = (proState.instaHandle || "").trim().replace(/^@+/, "");
      const instaUrl = rawInsta ? `https://instagram.com/${rawInsta}` : "https://instagram.com";
      const instaQrCanvas = await generateQRCodeCanvas(instaUrl, 600);

      // Grade 2x2 para 10x15cm (2362 x 3543 px)
      const marginX = 130;
      const gapX = 110;
      const gapY = 100;
      const cardW = (W - marginX * 2 - gapX) / 2; // 996 px
      const cardH = 1230;
      const startY = headerH + 95;

      const zapText =
        (proState.zapLabel || "").trim() ||
        formatPhoneBR(document.getElementById("wa-phone").value) ||
        "(85) 99999-9999";

      const cards = [
        {
          col: 0,
          row: 0,
          title: "WHATSAPP",
          badgeColor: "#16a34a",
          qrCanvas: waQrCanvas,
          qrImg: null,
          line1: zapText,
          line2: "Atendimento & Pedidos"
        },
        {
          col: 1,
          row: 0,
          title: "PAGUE COM PIX",
          badgeColor: "#0d9488",
          qrCanvas: null,
          qrImg: proState.pixImg,
          placeholder: "Envie o print do QR Pix",
          line1: (proState.pixHolder || "").trim() || "Pagamento Instantâneo",
          line2: (proState.pixKey || "").trim() ? `Chave: ${proState.pixKey.trim()}` : "Escaneie no app do banco"
        },
        {
          col: 0,
          row: 1,
          title: "WI-FI GRÁTIS",
          badgeColor: primary,
          qrCanvas: null,
          qrImg: proState.wifiImg,
          placeholder: "Envie o print do QR Wi-Fi",
          line1: (proState.wifiName || "").trim() ? `Rede: ${proState.wifiName.trim()}` : "Acesso para Clientes",
          line2: (proState.wifiPass || "").trim() ? `Senha: ${proState.wifiPass.trim()}` : "Aponte a câmera para conectar"
        },
        {
          col: 1,
          row: 1,
          title: "INSTAGRAM",
          badgeColor: "#db2777",
          qrCanvas: instaQrCanvas,
          qrImg: null,
          line1: rawInsta ? `@${rawInsta}` : "@sualoja",
          line2: "Siga nossas novidades"
        }
      ];

      for (const card of cards) {
        const cx = marginX + card.col * (cardW + gapX);
        const cy = startY + card.row * (cardH + gapY);

        // Cartão branco com borda
        ctx.fillStyle = "#f8fafc";
        roundRect(ctx, cx, cy, cardW, cardH, 46);
        ctx.fill();

        ctx.strokeStyle = "#cbd5e1";
        ctx.lineWidth = 6;
        roundRect(ctx, cx, cy, cardW, cardH, 46);
        ctx.stroke();

        // Faixa superior do cartão
        ctx.fillStyle = card.badgeColor;
        roundRect(ctx, cx + 48, cy + 44, cardW - 96, 118, 28);
        ctx.fill();

        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 62px Oswald, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText(card.title, cx + cardW / 2, cy + 124);

        // Área interna do QR
        const qrBoxSize = 680;
        const qrBoxX = cx + (cardW - qrBoxSize) / 2;
        const qrBoxY = cy + 205;

        ctx.fillStyle = "#ffffff";
        roundRect(ctx, qrBoxX, qrBoxY, qrBoxSize, qrBoxSize, 32);
        ctx.fill();
        ctx.strokeStyle = "#e2e8f0";
        ctx.lineWidth = 4;
        roundRect(ctx, qrBoxX, qrBoxY, qrBoxSize, qrBoxSize, 32);
        ctx.stroke();

        ctx.save();
        if (isProtected) {
          ctx.filter = "blur(18px)";
        }

        const innerPad = 34;
        if (card.qrCanvas) {
          ctx.drawImage(
            card.qrCanvas,
            qrBoxX + innerPad,
            qrBoxY + innerPad,
            qrBoxSize - innerPad * 2,
            qrBoxSize - innerPad * 2
          );
        } else if (card.qrImg) {
          ctx.drawImage(
            card.qrImg,
            qrBoxX + innerPad,
            qrBoxY + innerPad,
            qrBoxSize - innerPad * 2,
            qrBoxSize - innerPad * 2
          );
        } else {
          ctx.filter = "none";
          ctx.fillStyle = "#94a3b8";
          ctx.font = "bold 36px 'Plus Jakarta Sans', sans-serif";
          ctx.textAlign = "center";
          ctx.fillText(card.placeholder, cx + cardW / 2, qrBoxY + qrBoxSize / 2 + 12);
        }
        ctx.restore();

        // Textos informativos abaixo do QR
        ctx.fillStyle = "#0f172a";
        ctx.font = "bold 46px 'Plus Jakarta Sans', sans-serif";
        ctx.textAlign = "center";
        ctx.fillText(card.line1.slice(0, 28), cx + cardW / 2, cy + 985);

        ctx.fillStyle = "#475569";
        ctx.font = "600 38px 'Plus Jakarta Sans', sans-serif";
        ctx.fillText(card.line2.slice(0, 34), cx + cardW / 2, cy + 1055);
      }

      // Rodapé
      const footerH = 140;
      ctx.fillStyle = primary;
      ctx.fillRect(0, H - footerH, W, footerH);

      ctx.fillStyle = "#ffffff";
      ctx.font = "bold 42px 'Plus Jakarta Sans', sans-serif";
      ctx.textAlign = "center";
      ctx.fillText("OBRIGADO PELA PREFERÊNCIA!", W / 2, H - 55);

      // Marca d'água de proteção enquanto não liberado
      if (isProtected) {
        ctx.save();
        ctx.translate(W / 2, H / 2);
        ctx.rotate((-32 * Math.PI) / 180);
        ctx.fillStyle = "rgba(15, 23, 42, 0.16)";
        ctx.font = "bold 135px Oswald, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("PRÉVIA PROTEGIDA • SUBLIBOX QR", 0, -240);
        ctx.fillText("PRÉVIA PROTEGIDA • SUBLIBOX QR", 0, 120);
        ctx.fillText("PRÉVIA PROTEGIDA • SUBLIBOX QR", 0, 480);
        ctx.restore();
      }
    }

    // =========================================================================
    // RECORTE INTERATIVO DE PRINT (PIX / WI-FI) E EXTRAÇÃO DE CORES DA LOGO
    // =========================================================================
    const cropState = {
      targetType: null,
      img: null,
      zoom: 1,
      offsetX: 0,
      offsetY: 0,
      dragging: false,
      lastX: 0,
      lastY: 0
    };

    function openCropModal(img, targetType, title) {
      cropState.targetType = targetType;
      cropState.img = img;
      cropState.zoom = 1;
      cropState.offsetX = 0;
      cropState.offsetY = 0;
      document.getElementById("crop-zoom").value = "1";
      document.getElementById("crop-zoom-val").textContent = "100%";
      document.getElementById("crop-modal-title").textContent = title;

      const modal = document.getElementById("crop-modal");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      drawCropPreview();
    }

    function closeCropModal() {
      const modal = document.getElementById("crop-modal");
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }

    function drawCropPreview() {
      if (!cropState.img) return;
      const canvas = document.getElementById("crop-preview-canvas");
      const ctx = canvas.getContext("2d");
      const size = 320;
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, size, size);

      const baseScale = Math.max(size / cropState.img.width, size / cropState.img.height);
      const scale = baseScale * cropState.zoom;
      const dw = cropState.img.width * scale;
      const dh = cropState.img.height * scale;
      const dx = (size - dw) / 2 + cropState.offsetX;
      const dy = (size - dh) / 2 + cropState.offsetY;

      ctx.drawImage(cropState.img, dx, dy, dw, dh);
    }

    function extractDominantColors(img) {
      try {
        const c = document.createElement("canvas");
        c.width = 64;
        c.height = 64;
        const ctx = c.getContext("2d");
        ctx.drawImage(img, 0, 0, 64, 64);
        const data = ctx.getImageData(0, 0, 64, 64).data;
        const buckets = new Map();

        for (let i = 0; i < data.length; i += 4) {
          const r = data[i];
          const g = data[i + 1];
          const b = data[i + 2];
          const a = data[i + 3];
          if (a < 180) continue;
          if (r > 235 && g > 235 && b > 235) continue;
          if (r < 20 && g < 20 && b < 20) continue;
          const key = `${Math.round(r / 24) * 24},${Math.round(g / 24) * 24},${Math.round(b / 24) * 24}`;
          buckets.set(key, (buckets.get(key) || 0) + 1);
        }

        const sorted = Array.from(buckets.entries()).sort((a, b) => b[1] - a[1]);
        if (sorted.length > 0) {
          const toHex = (rgbStr) =>
            "#" +
            rgbStr
              .split(",")
              .map((n) => Math.min(255, Number(n)).toString(16).padStart(2, "0"))
              .join("");
          proState.primaryColor = toHex(sorted[0][0]);
          document.getElementById("pro-primary-color").value = proState.primaryColor;
          if (sorted.length > 1) {
            proState.secondaryColor = toHex(sorted[1][0]);
            document.getElementById("pro-secondary-color").value = proState.secondaryColor;
          }
          renderProBoard();
          showToast("Cores extraídas da sua logomarca!");
        }
      } catch (e) {}
    }

    function loadImageFile(file, callback) {
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        const img = new Image();
        img.onload = () => callback(img);
        img.src = ev.target.result;
      };
      reader.readAsDataURL(file);
    }

    // =========================================================================
    // PERSISTÊNCIA VOLÁTIL DE SESSÃO & CHECKOUT MERCADO PAGO
    // =========================================================================
    function saveVolatileCheckoutState() {
      try {
        const snapshot = {
          orderRef: proState.orderRef,
          sessionToken: proState.sessionToken,
          validatedPaymentId: proState.validatedPaymentId,
          phone: document.getElementById("wa-phone").value,
          message: document.getElementById("wa-message").value,
          companyName: proState.companyName,
          showCompany: proState.showCompany,
          showLogo: proState.showLogo,
          primaryColor: proState.primaryColor,
          secondaryColor: proState.secondaryColor,
          wifiName: proState.wifiName,
          wifiPass: proState.wifiPass,
          pixHolder: proState.pixHolder,
          pixKey: proState.pixKey,
          instaHandle: proState.instaHandle,
          zapLabel: proState.zapLabel,
          logoSrc: proState.logoImg ? proState.logoImg.src : null,
          wifiSrc: proState.wifiImg ? proState.wifiImg.src : null,
          pixSrc: proState.pixImg ? proState.pixImg.src : null
        };
        sessionStorage.setItem("sublibox_volatile_checkout", JSON.stringify(snapshot));
      } catch (e) {}
    }

    function restoreVolatileCheckoutState() {
      try {
        const raw = sessionStorage.getItem("sublibox_volatile_checkout");
        if (!raw) return;
        const d = JSON.parse(raw);

        if (d.orderRef) proState.orderRef = d.orderRef;
        if (d.sessionToken) proState.sessionToken = d.sessionToken;
        if (d.validatedPaymentId) proState.validatedPaymentId = d.validatedPaymentId;

        if (d.phone) document.getElementById("wa-phone").value = d.phone;
        if (d.message) document.getElementById("wa-message").value = d.message;

        proState.companyName = d.companyName || "";
        document.getElementById("pro-company").value = proState.companyName;

        proState.showCompany = d.showCompany !== false;
        document.getElementById("pro-show-company").checked = proState.showCompany;

        proState.showLogo = d.showLogo !== false;
        document.getElementById("pro-show-logo").checked = proState.showLogo;

        if (d.primaryColor) {
          proState.primaryColor = d.primaryColor;
          document.getElementById("pro-primary-color").value = d.primaryColor;
        }
        if (d.secondaryColor) {
          proState.secondaryColor = d.secondaryColor;
          document.getElementById("pro-secondary-color").value = d.secondaryColor;
        }

        proState.wifiName = d.wifiName || "";
        document.getElementById("pro-wifi-name").value = proState.wifiName;

        proState.wifiPass = d.wifiPass || "";
        document.getElementById("pro-wifi-pass").value = proState.wifiPass;

        proState.pixHolder = d.pixHolder || "";
        document.getElementById("pro-pix-holder").value = proState.pixHolder;

        proState.pixKey = d.pixKey || "";
        document.getElementById("pro-pix-key").value = proState.pixKey;

        proState.instaHandle = d.instaHandle || "";
        document.getElementById("pro-insta").value = proState.instaHandle;

        proState.zapLabel = d.zapLabel || "";
        document.getElementById("pro-zap-label").value = proState.zapLabel;

        const restoreImg = (src, assignFn) => {
          if (!src) return;
          const img = new Image();
          img.onload = () => {
            assignFn(img);
            renderProBoard();
          };
          img.src = src;
        };

        restoreImg(d.logoSrc, (img) => {
          proState.logoImg = img;
          document.getElementById("extract-logo-colors").classList.remove("hidden");
        });
        restoreImg(d.wifiSrc, (img) => {
          proState.wifiImg = img;
        });
        restoreImg(d.pixSrc, (img) => {
          proState.pixImg = img;
        });
      } catch (e) {}
    }

    function unlockProMode({ paymentId, orderRef, downloadGrant, customizationHash }) {
      if (!paymentId || !orderRef || !downloadGrant) return;
      proState.unlocked = true;
      proState.validatedPaymentId = String(paymentId);
      proState.orderRef = String(orderRef);
      proState.downloadGrant = String(downloadGrant);
      proState.approvedCustomizationHash = String(customizationHash || "");
      saveVolatileCheckoutState();

      document.getElementById("pro-locked-panel").classList.add("hidden");
      document.getElementById("pro-unlocked-panel").classList.remove("hidden");
      document.getElementById("pro-price-display").textContent = "LIBERADO";
      renderProBoard();
    }

    async function verifyPaymentWithServer(paymentId = "", orderRefOverride = "") {
      const cleanId = cleanDigits(paymentId);
      const targetOrderRef = String(orderRefOverride || proState.orderRef || "").trim();

      if (!cleanId && !targetOrderRef) {
        showToast("Digite um número de pagamento válido.");
        return false;
      }

      try {
        const customizationHash = await computeBoardCustomizationHash();
        const headers = { "Content-Type": "application/json" };
        if (proState.sessionToken) {
          headers["X-Order-Session"] = proState.sessionToken;
        }

        const res = await fetch("/api/verificar-pagamento", {
          method: "POST",
          credentials: "same-origin",
          headers,
          body: JSON.stringify({
            payment_id: cleanId || undefined,
            order_ref: targetOrderRef || undefined,
            session_token: proState.sessionToken || undefined,
            customization_hash: customizationHash
          })
        });

        const data = await res.json();
        if (res.ok && data.aprovado && data.download_grant) {
          unlockProMode({
            paymentId: data.payment_id || cleanId,
            orderRef: data.order_ref || targetOrderRef,
            downloadGrant: data.download_grant,
            customizationHash
          });
          trackFunnelEvent("pro_payment_approved", { paymentId: data.payment_id || cleanId });
          return true;
        } else {
          showToast(data.error || "Pagamento não validado para esta placa.");
          return false;
        }
      } catch (e) {
        showToast("Erro de conexão ao validar o pagamento no servidor.");
        return false;
      }
    }

    async function iniciarCheckoutPro() {
      const btn = document.getElementById("pro-pay-btn");
      const originalText = btn.textContent;
      trackFunnelEvent("pro_checkout_started", { price: 9.9 });
      btn.disabled = true;
      btn.textContent = "Conectando ao Mercado Pago...";

      try {
        const customizationHash = await computeBoardCustomizationHash();
        const res = await fetch("/api/criar-pagamento", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            customization_hash: customizationHash
          })
        });
        const data = await res.json();
        if (!res.ok || !data.init_point || !data.order_ref) {
          throw new Error(data.error || "Falha ao iniciar o Checkout Pro.");
        }
        proState.orderRef = data.order_ref;
        proState.sessionToken = data.session_token || null;
        saveVolatileCheckoutState();
        window.location.href = data.init_point;
      } catch (err) {
        btn.disabled = false;
        btn.textContent = originalText;
        showToast(err.message || "Não foi possível iniciar o pagamento agora.");
      }
    }

    async function checkServerReturn() {
      const params = new URLSearchParams(window.location.search);
      const paymentId = params.get("payment_id") || params.get("collection_id") || "";
      const urlOrderRef = params.get("order_ref") || "";
      if (urlOrderRef) {
        proState.orderRef = urlOrderRef;
      }

      const targetOrderRef = urlOrderRef || proState.orderRef || "";
      const savedPaymentId = paymentId || proState.validatedPaymentId || "";

      if (savedPaymentId || targetOrderRef) {
        showToast("Validando pagamento no servidor...");
        const ok = await verifyPaymentWithServer(savedPaymentId, targetOrderRef);
        if (ok) {
          if (params.has("payment_id") || params.has("collection_id") || params.has("retorno")) {
            window.history.replaceState({}, document.title, window.location.pathname + "#placa-pro");
            const sec = document.getElementById("placa-pro");
            if (sec) sec.scrollIntoView({ behavior: "smooth" });
          }
          showToast("Pagamento confirmado! Placa 10×15cm PRO liberada.");
        }
      }
    }

    // =========================================================================
    // EXPORTAÇÃO FINAL (PNG 600 DPI & PDF A4 100x150mm)
    // =========================================================================
    async function exportProBoard10x15(mode = "png") {
      if (!proState.unlocked || !proState.validatedPaymentId || !proState.orderRef || !proState.downloadGrant) {
        showToast("Valide o pagamento antes de baixar o arquivo final.");
        return;
      }

      try {
        const currentHash = await computeBoardCustomizationHash();
        const headers = { "Content-Type": "application/json" };
        if (proState.sessionToken) {
          headers["X-Order-Session"] = proState.sessionToken;
        }

        const authRes = await fetch("/api/autorizar-download", {
          method: "POST",
          credentials: "same-origin",
          headers,
          body: JSON.stringify({
            order_ref: proState.orderRef,
            payment_id: proState.validatedPaymentId,
            session_token: proState.sessionToken || undefined,
            customization_hash: currentHash,
            download_grant: proState.downloadGrant
          })
        });

        const authData = await authRes.json();
        if (!authRes.ok || !authData.authorized) {
          showToast(authData.error || "Download não autorizado para esta placa.");
          return;
        }

        if (authData.download_grant) {
          proState.downloadGrant = authData.download_grant;
        }
      } catch (e) {
        showToast("Erro de conexão ao validar permissão de download.");
        return;
      }

      const exportCanvas = document.createElement("canvas");
      await renderProBoard(exportCanvas, true);
      const dataUrl = exportCanvas.toDataURL("image/png");

      if (mode === "png") {
        const link = document.createElement("a");
        link.download = "placa-balcao-4em1-pro-10x15cm-600dpi.png";
        link.href = dataUrl;
        link.click();
        showToast("PNG 10×15cm (600 DPI) baixado!");
        return;
      }

      // PDF A4 (210 x 297 mm) com arte centralizada exatamente em 100 x 150 mm
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({
        orientation: "portrait",
        unit: "mm",
        format: "a4"
      });

      const pageW = 210;
      const pageH = 297;
      const boardW = 100;
      const boardH = 150;
      const offsetX = (pageW - boardW) / 2; // 55 mm
      const offsetY = (pageH - boardH) / 2; // 73.5 mm

      pdf.addImage(dataUrl, "PNG", offsetX, offsetY, boardW, boardH);

      // Guias discretas de corte fora da arte
      pdf.setDrawColor(148, 163, 184);
      pdf.setLineWidth(0.2);
      pdf.rect(offsetX, offsetY, boardW, boardH);

      pdf.setFontSize(8);
      pdf.setTextColor(100, 116, 139);
      pdf.text("Imprimir em Tamanho Real (100%) • Medida exata: 10,0 x 15,0 cm", pageW / 2, offsetY + boardH + 8, {
        align: "center"
      });

      pdf.save("placa-balcao-4em1-pro-10x15cm-A4.pdf");
      showToast("PDF A4 (10×15cm) gerado com sucesso!");
    }

    // =========================================================================
    // INICIALIZAÇÃO E LISTENERS
    // =========================================================================
    document.addEventListener("DOMContentLoaded", async () => {
      restoreVolatileCheckoutState();
      await updateMainQR();
      await checkServerReturn();

      // Inputs WhatsApp
      const waPhoneInput = document.getElementById("wa-phone");
      waPhoneInput.addEventListener("input", () => {
        waPhoneInput.value = formatPhoneBR(waPhoneInput.value);
        updateMainQR();
      });

      document.getElementById("wa-message").addEventListener("input", updateMainQR);

      document.getElementById("copy-wa-link").addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(buildWhatsAppUrl());
          showToast("Link do WhatsApp copiado!");
        } catch (e) {
          showToast("Não foi possível copiar automaticamente.");
        }
      });

      document.getElementById("download-free-qr").addEventListener("click", () => {
        const link = document.createElement("a");
        link.download = "qrcode-whatsapp-gratis.png";
        link.href = document.getElementById("free-qr-canvas").toDataURL("image/png");
        link.click();
        showToast("QR Code WhatsApp baixado!");
      });

      document.getElementById("download-simple-board").addEventListener("click", () => {
        const link = document.createElement("a");
        link.download = "placa-simples-whatsapp-10x15cm.png";
        link.href = document.getElementById("simple-board-canvas").toDataURL("image/png");
        link.click();
        showToast("Placa Simples 10×15cm baixada!");
      });

      // Inputs Placa PRO
      document.getElementById("pro-company").addEventListener("input", (e) => {
        proState.companyName = e.target.value;
        renderProBoard();
      });

      document.getElementById("pro-show-company").addEventListener("change", (e) => {
        proState.showCompany = e.target.checked;
        renderProBoard();
      });

      document.getElementById("pro-show-logo").addEventListener("change", (e) => {
        proState.showLogo = e.target.checked;
        renderProBoard();
      });

      document.getElementById("pro-primary-color").addEventListener("input", (e) => {
        proState.primaryColor = e.target.value;
        renderProBoard();
      });

      document.getElementById("pro-secondary-color").addEventListener("input", (e) => {
        proState.secondaryColor = e.target.value;
        renderProBoard();
      });

      document.getElementById("pro-logo-input").addEventListener("change", (e) => {
        loadImageFile(e.target.files[0], (img) => {
          proState.logoImg = img;
          document.getElementById("extract-logo-colors").classList.remove("hidden");
          extractDominantColors(img);
          renderProBoard();
        });
      });

      document.getElementById("extract-logo-colors").addEventListener("click", () => {
        if (proState.logoImg) extractDominantColors(proState.logoImg);
      });

      document.getElementById("pro-pix-input").addEventListener("change", (e) => {
        loadImageFile(e.target.files[0], (img) => {
          openCropModal(img, "pix", "Recortar QR Code do Pix");
        });
      });

      document.getElementById("pro-wifi-input").addEventListener("change", (e) => {
        loadImageFile(e.target.files[0], (img) => {
          openCropModal(img, "wifi", "Recortar QR Code do Wi-Fi");
        });
      });

      document.getElementById("pro-pix-holder").addEventListener("input", (e) => {
        proState.pixHolder = e.target.value;
        renderProBoard();
      });

      document.getElementById("pro-pix-key").addEventListener("input", (e) => {
        proState.pixKey = e.target.value;
        renderProBoard();
      });

      document.getElementById("pro-wifi-name").addEventListener("input", (e) => {
        proState.wifiName = e.target.value;
        renderProBoard();
      });

      document.getElementById("pro-wifi-pass").addEventListener("input", (e) => {
        proState.wifiPass = e.target.value;
        renderProBoard();
      });

      document.getElementById("pro-insta").addEventListener("input", (e) => {
        proState.instaHandle = e.target.value;
        renderProBoard();
      });

      document.getElementById("pro-zap-label").addEventListener("input", (e) => {
        proState.zapLabel = e.target.value;
        renderProBoard();
      });

      // Modal de Recorte
      const cropCanvas = document.getElementById("crop-preview-canvas");
      cropCanvas.addEventListener("mousedown", (e) => {
        cropState.dragging = true;
        cropState.lastX = e.clientX;
        cropState.lastY = e.clientY;
      });
      window.addEventListener("mouseup", () => {
        cropState.dragging = false;
      });
      window.addEventListener("mousemove", (e) => {
        if (!cropState.dragging) return;
        cropState.offsetX += e.clientX - cropState.lastX;
        cropState.offsetY += e.clientY - cropState.lastY;
        cropState.lastX = e.clientX;
        cropState.lastY = e.clientY;
        drawCropPreview();
      });

      cropCanvas.addEventListener(
        "touchstart",
        (e) => {
          if (e.touches.length === 1) {
            cropState.dragging = true;
            cropState.lastX = e.touches[0].clientX;
            cropState.lastY = e.touches[0].clientY;
          }
        },
        { passive: true }
      );
      cropCanvas.addEventListener("touchend", () => {
        cropState.dragging = false;
      });
      cropCanvas.addEventListener(
        "touchmove",
        (e) => {
          if (!cropState.dragging || e.touches.length !== 1) return;
          cropState.offsetX += e.touches[0].clientX - cropState.lastX;
          cropState.offsetY += e.touches[0].clientY - cropState.lastY;
          cropState.lastX = e.touches[0].clientX;
          cropState.lastY = e.touches[0].clientY;
          drawCropPreview();
        },
        { passive: true }
      );

      document.getElementById("crop-zoom").addEventListener("input", (e) => {
        cropState.zoom = Number(e.target.value);
        document.getElementById("crop-zoom-val").textContent = `${Math.round(cropState.zoom * 100)}%`;
        drawCropPreview();
      });

      document.getElementById("crop-cancel-btn").addEventListener("click", closeCropModal);

      document.getElementById("crop-confirm-btn").addEventListener("click", () => {
        const croppedImg = new Image();
        croppedImg.onload = () => {
          if (cropState.targetType === "pix") {
            proState.pixImg = croppedImg;
          } else if (cropState.targetType === "wifi") {
            proState.wifiImg = croppedImg;
          }
          renderProBoard();
          closeCropModal();
          showToast("QR Code recortado e aplicado na placa!");
        };
        croppedImg.src = cropCanvas.toDataURL("image/png");
      });

      // Checkout e Downloads PRO
      document.getElementById("pro-pay-btn").addEventListener("click", iniciarCheckoutPro);

      document.getElementById("manual-verify-btn").addEventListener("click", () => {
        const val = document.getElementById("manual-payment-id").value;
        verifyPaymentWithServer(val);
      });

      document.getElementById("download-pro-png").addEventListener("click", () => exportProBoard10x15("png"));
      document.getElementById("download-pro-pdf").addEventListener("click", () => exportProBoard10x15("pdf"));
    });
  </script>
</body>
</html>
